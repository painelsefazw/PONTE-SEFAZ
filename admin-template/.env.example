# Console de clientes da ponte fiscal.
# Copie para .env (desenvolvimento) ou cadastre no provedor (producao).
# NENHUMA delas pode receber o prefixo VITE_: o que leva esse prefixo vai para o
# pacote do navegador, e a chave da ponte no navegador e a ponte inteira aberta.

# Endereco da ponte que este console administra.
EMISSOR_API_URL=

# A WEBAPP_SENHA da ponte. E a credencial de administrador dela.
EMISSOR_ADMIN_KEY=

# Senha para entrar NESTE console. Separada da chave da ponte de proposito.
APP_ACCESS_PASSWORD=

# Opcionais ------------------------------------------------------------------
# Usuario do console. Vazio = admin.
APP_USER=
# Assina o cookie. Vazio = derivado da chave da ponte por HMAC.
SESSION_SECRET=
