# Variaveis desta instancia da ponte fiscal.
# Copie para .env (desenvolvimento) ou cadastre no provedor (producao).
# NENHUMA delas vai para o repositorio.

# ── Obrigatorias ────────────────────────────────────────────────────────
# Postgres do Supabase. Sem ela nada persiste: nem nota, nem cliente, nem chave. Se preferir nao montar a URL a mao, deixe vazia e preencha as tres NFE_DB_* abaixo.
NFE_DB_URL=

# ALTERNATIVA a NFE_DB_URL: so a senha do banco, sozinha. O codigo codifica os simbolos.
NFE_DB_PASSWORD=

# ALTERNATIVA a NFE_DB_URL: a referencia do projeto Supabase (o pedaco do meio da URL do painel).
NFE_DB_REF=

# ALTERNATIVA a NFE_DB_URL: o host do pooler, ex. aws-0-us-west-2.pooler.supabase.com.
NFE_DB_HOST=

# OPCIONAL. `revenda` mostra so Painel e Clientes API; `completo` mostra tudo. Sem ela, deduz-se: sem emitente proprio configurado, nasce em revenda.
WEBAPP_MODO=

# Senha do painel administrativo desta instancia.
WEBAPP_SENHA=

# Cifra os certificados A1 guardados no banco. Trocar depois torna ilegiveis os ja enviados.
WEBAPP_MASTER_KEY=

# ── Emitente padrao: so para a ponte emitir em NOME PROPRIO ─────────────
# Cliente de API nao usa nada disto: cada um tem certificado e cadastro
# fiscal proprios. Uma ponte que so revende sobe sem preencher nada aqui.
# Certificado A1 do emitente padrao, em base64.
NFE_PFX_BASE64=

# Senha do certificado.
NFE_PFX_PASSWORD=

# CNPJ do emitente padrao.
NFE_CNPJ_EMITENTE=

# Razao social do emitente padrao.
NFE_RAZAO_SOCIAL=

# Inscricao estadual do emitente padrao.
NFE_IE=

# UF do emitente. Decide o endpoint da SEFAZ.
NFE_UF=

# Endereco do emitente.
NFE_LOGRADOURO=

# Numero do endereco.
NFE_NUMERO=

# Bairro.
NFE_BAIRRO=

# Codigo IBGE do municipio (7 digitos). Errar aqui rejeita a nota.
NFE_COD_MUNICIPIO=

# Nome do municipio.
NFE_NOME_MUNICIPIO=

# CEP.
NFE_CEP=

# ── Recomendadas ────────────────────────────────────────────────────────
# Endereco publico DESTA instancia. Sem ele as plataformas geradas apontam para o lugar errado.
API_PUBLIC_URL=

# Servico que transforma XML em PDF. Pode ser o mesmo da instancia existente: ele nao guarda estado.
DANFE_SERVICE_URL=

# Chave do servico de DANFE.
DANFE_KEY=

# 1 producao, 2 homologacao. Padrao 2 — comece por ele.
NFE_AMBIENTE=

# Regime tributario do emitente padrao. 1 Simples, 3 Normal.
NFE_CRT=

# Protege as rotas de cron (reenvio de webhook, keepalive).
CRON_SECRET=

# So para publicar plataforma de cliente direto do painel. Fine-grained, com Contents read/write nos repositorios das plataformas.
GITHUB_TOKEN=

# ── Opcionais ───────────────────────────────────────────────────────────
# Envio de DANFE e XML por e-mail.
SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS / SMTP_FROM=

# Nome fantasia.
NFE_FANTASIA=

# Complemento do endereco.
NFE_COMPLEMENTO=

# Telefone.
NFE_FONE=

# Acesso padrao das plataformas geradas.
PLATAFORMA_LOGIN_PADRAO / PLATAFORMA_SENHA_PADRAO=
